{
  "entities": {
    "Room": {
      "title": "Room",
      "description": "A synchronized group meetup decision room.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "creatorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "creatorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "category": {
          "type": "string",
          "enum": ["food", "movie", "activity"]
        },
        "mode": {
          "type": "string",
          "enum": ["full", "quick"]
        },
        "status": {
          "type": "string",
          "enum": ["open", "locked"]
        },
        "durationMinutes": {
          "type": "number"
        },
        "endsAt": {
          "type": "number"
        },
        "selectedTimeSlotId": {
          "type": "string",
          "maxLength": 128
        },
        "selectedCardId": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "creatorId",
        "creatorName",
        "title",
        "category",
        "mode",
        "status",
        "durationMinutes",
        "endsAt",
        "createdAt",
        "updatedAt"
      ]
    },
