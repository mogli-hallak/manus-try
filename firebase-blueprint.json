  "firestore": {
    "/rooms/{roomId}": {
      "schema": { "$ref": "#/entities/Room" },
      "description": "Meetup room configuration, creatorId, status, and timer."
    },
    "/rooms/{roomId}/participants/{participantId}": {
      "schema": { "$ref": "#/entities/Participant" },
      "description": "Joined room members keyed by their Firebase Auth UID."
    },
    "/rooms/{roomId}/timeOptions/{slotId}": {
      "schema": { "$ref": "#/entities/TimeOption" },
      "description": "Proposed meetup day and time slots."
    },
    "/rooms/{roomId}/timeVotes/{voterId}": {
      "schema": { "$ref": "#/entities/TimeVote" },
      "description": "Selected time slot IDs per participant UID."
    },
    "/rooms/{roomId}/cards/{cardId}": {
      "schema": { "$ref": "#/entities/CustomCard" },
      "description": "Custom idea cards added to the room swipe deck."
    },
    "/rooms/{roomId}/swipes/{voterId}": {
      "schema": { "$ref": "#/entities/SwipeRecord" },
      "description": "Swipe decisions (0/1/2) per participant UID."
    },
    "/rooms/{roomId}/checklist/{itemId}": {
      "schema": { "$ref": "#/entities/ChecklistItem" },
      "description": "Shared meetup checklist items with atomic claim locking."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile and personal preferences, owner-scoped."
    },
    "/users/{userId}/friends/{friendId}": {
      "schema": { "$ref": "#/entities/SavedFriend" },
      "description": "Owner-scoped saved friends and quick contacts."
    },
    "/publicProfiles/{friendCode}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Shareable non-PII public card lookup by friendCode."
    },
    "/friendRequests/{requestId}": {
      "schema": { "$ref": "#/entities/FriendRequest" },
      "description": "Peer-to-peer friend requests visible only to sender and recipient."
    },
    "/groups/{groupId}": {
      "schema": { "$ref": "#/entities/FriendGroup" },
      "description": "Shared friend groups with bounded memberUids for recurring meetups."
    },
    "/groups/{groupId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/GroupMember" },
      "description": "Normalized member profiles for a friend group."
    }
  }
}
